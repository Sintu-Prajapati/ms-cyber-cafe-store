<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Order Placed | MS Cyber Cafe</title>

    <link rel="stylesheet" href="/css/customer-order-success.css">
    <link rel="stylesheet" href="/css/customer-home.css">
    <link rel="stylesheet" href="/css/responsive.css?v=1">
</head>

<body>

    <header class="customer-navbar">

        <div class="brand">

            <div class="brand-icon"  onclick="window.location.href='/'">
                🛒
            </div>

            <div>

                <h1>
                    MS Cyber Cafe
                </h1>

                <span>
                    & General Store
                </span>

            </div>

        </div>



        <div class="nav-actions">

            <button class="search-btn" onclick="focusSearch()" title="Search">
                🔍
            </button>


            <button class="cart-btn" onclick="openCart()" title="Cart">

                🛒

                <span id="cartCount">
                    0
                </span>

            </button>



            <a href="/customer/profile" class="action-link profile-btn" title="Profile">
                👤 Profile
            </a>

            


        </div>

    </header>


    <main class="success-page">

        <div class="success-container">


            <!-- SUCCESS ICON -->

            <div class="success-icon">
                ✓
            </div>


            <h1>
                Order Placed Successfully!
            </h1>

            <p class="success-message">
                Thank you for your order.
                We have received your order and will
                start processing it soon.
            </p>


            <!-- ORDER CARD -->

            <div class="order-card">

                <div class="order-header">

                    <div>

                        <span>
                            Order ID
                        </span>

                        <strong>
                            #<%= order.orderId %>
                        </strong>

                    </div>


                    <div class="status-badge">
                        <%= order.orderStatus %>
                    </div>

                </div>


                <div class="divider"></div>


                <!-- ORDER DETAILS -->

                <div class="details-grid">

                    <div class="detail">

                        <span>
                            Total Amount
                        </span>

                        <strong class="amount">
                            ₹<%= Number( order.grandTotal ).toFixed(2) %>
                        </strong>

                    </div>


                    <div class="detail">

                        <span>
                            Payment Method
                        </span>

                        <strong>

                            <% if ( order.paymentMethod==="COD" ) { %>

                                💵 Cash on Delivery

                                <% } else { %>

                                    📱 UPI / Online

                                    <% } %>

                        </strong>

                    </div>


                    <div class="detail">

                        <span>
                            Payment Status
                        </span>

                        <strong>

                            <%= order.paymentStatus %>

                        </strong>

                    </div>


                    <div class="detail">

                        <span>
                            Order Date
                        </span>

                        <strong>

                            <%= new Date( order.createdAt ).toLocaleDateString( "en-IN" ) %>

                        </strong>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="address-section">

                    <h3>
                        📍 Delivery Address
                    </h3>

                    <p>

                        <strong>
                            <%= order.deliveryAddress.name %>
                        </strong>

                    </p>

                    <p>
                        📞
                        <%= order.deliveryAddress.number %>
                    </p>

                    <p>

                        <%= order.deliveryAddress.house %>,
                            <%= order.deliveryAddress.village %>,

                                <%= order.deliveryAddress.district %>,

                                    <%= order.deliveryAddress.state %>
                                        -
                                        <%= order.deliveryAddress.pincode %>

                    </p>

                </div>

            </div>


            <!-- BUTTONS -->

            <div class="success-buttons">

                <a href="/customer/orders" class="primary-btn">
                    📦 View My Orders
                </a>


                <a href="/customer/home" class="secondary-btn">
                    🛍️ Continue Shopping
                </a>

            </div>


            <p class="bottom-message">
                You can track your order from
                <strong>My Orders</strong>.
            </p>

        </div>

    </main>


    <footer>


        <div class="footer-brand">

            🛒

            <strong>
                MS Cyber Cafe & General Store
            </strong>

        </div>


        <p>
            Your trusted local store for daily needs.
        </p>


        <small>

            © <%= new Date().getFullYear() %>
                MS Cyber Cafe & General Store 
                <a style="text-decoration: none; color: white; font-weight: 600;" href="/customer/about">About Us</a>


        </small>


    </footer>

</body>

</html>