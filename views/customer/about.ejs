<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        About Us | MS Cyber Cafe & General Store
    </title>

    <link
        rel="stylesheet"
        href="/css/about.css"
    >
    <link rel="stylesheet" href="/css/customer-home.css">

</head>


<body>


    <!-- =========================
         HEADER
    ========================== -->
   <header class="customer-navbar">

        <div class="brand">

            <div class="brand-icon"  onclick="window.location.href='/'">
                🛒
            </div>

            <div>

                <h1>
                    MS Cyber Cafe
                </h1>

                <span>
                    & General Store
                </span>

            </div>

        </div>
       


        <div class="nav-actions">

            <button
                class="search-btn"
                onclick="focusSearch()"
                title="Search"
            >
                🔍
            </button>


            <button
                class="cart-btn"
                onclick="openCart()"
                title="Cart"
            >

                🛒

                <span id="cartCount">
                    0
                </span>

            </button>
               
             

                <a
                  href="/customer/profile"
                  class="action-link profile-btn"
                  title="Profile"
                >
                    👤 Profile
                </a>

               
               

        </div>

    </header>




    <!-- =========================
         HERO
    ========================== -->

    <section class="about-hero">

        <div class="hero-content">

            <span class="hero-label">
                ABOUT US
            </span>

            <h1>
                MS Cyber Cafe
                <br>
                <span>& General Store</span>
            </h1>

            <p>
                Your trusted local store for everyday
                products with simple and convenient
                home delivery.
            </p>

            <a
                href="/customer/products"
                class="shop-btn"
            >
                🛒 Start Shopping
            </a>

        </div>


        <div class="hero-visual">

            <div class="hero-circle">

                🛍️

            </div>

            <div class="floating-card card-one">
                📦 Easy Ordering
            </div>

            <div class="floating-card card-two">
                🚚 Home Delivery
            </div>

        </div>

    </section>



    <!-- =========================
         ABOUT STORE
    ========================== -->

    <section class="section">

        <div class="section-heading">

            <span>
                OUR STORE
            </span>

            <h2>
                About MS Cyber Cafe & General Store
            </h2>

        </div>


        <div class="about-card">

            <div class="about-icon">
                🏪
            </div>

            <div>

                <p>
                    MS Cyber Cafe & General Store is a
                    local shopping and home-delivery
                    platform designed to make everyday
                    shopping easier and more convenient.
                </p>

                <p>
                    Customers can browse available
                    products, add items to their cart,
                    provide their delivery address and
                    place an order from the comfort of
                    their home.
                </p>

                <p>
                    The platform connects customers,
                    store administration and delivery
                    staff in one simple system.
                </p>

            </div>

        </div>

    </section>



    <!-- =========================
         FEATURES
    ========================== -->

    <section class="section light-section">

        <div class="section-heading center">

            <span>
                WHAT WE OFFER
            </span>

            <h2>
                Everything in One Place
            </h2>

            <p>
                Designed to make local shopping simple.
            </p>

        </div>


        <div class="feature-grid">


            <div class="feature-card">

                <div class="feature-icon">
                    🛒
                </div>

                <h3>
                    Easy Shopping
                </h3>

                <p>
                    Browse products and add the
                    required items to your cart easily.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    📍
                </div>

                <h3>
                    Easy Address Selection
                </h3>

                <p>
                    Save your delivery address and
                    select your location when required.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🚚
                </div>

                <h3>
                    Home Delivery
                </h3>

                <p>
                    Get your ordered products delivered
                    to your selected address.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    📦
                </div>

                <h3>
                    Order Tracking
                </h3>

                <p>
                    Check your order status from
                    placement to delivery.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    👤
                </div>

                <h3>
                    Customer Account
                </h3>

                <p>
                    Manage your profile, saved address
                    and previous orders.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    💳
                </div>

                <h3>
                    Flexible Payment
                </h3>

                <p>
                    Payment and order status are
                    managed along with your order.
                </p>

            </div>


        </div>

    </section>



    <!-- =========================
         HOW IT WORKS
    ========================== -->

    <section class="section">

        <div class="section-heading center">

            <span>
                HOW IT WORKS
            </span>

            <h2>
                From Order to Delivery
            </h2>

        </div>


        <div class="steps">


            <div class="step">

                <div class="step-number">
                    01
                </div>

                <div>

                    <h3>
                        Browse Products
                    </h3>

                    <p>
                        Find the products you need
                        from the store.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    02
                </div>

                <div>

                    <h3>
                        Add to Cart
                    </h3>

                    <p>
                        Select products and quantities
                        and add them to your cart.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    03
                </div>

                <div>

                    <h3>
                        Place Order
                    </h3>

                    <p>
                        Confirm your address and
                        place your order.
                    </p>

                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    04
                </div>

                <div>

                    <h3>
                        Get Delivery
                    </h3>

                    <p>
                        Your order is prepared and
                        delivered to you.
                    </p>

                </div>

            </div>


        </div>

    </section>



    <!-- =========================
         PROJECT
    ========================== -->

    <section class="section project-section">

        <div class="project-content">

            <div class="project-label">
                THE PROJECT
            </div>

            <h2>
                A Complete Local
                <span>Home Delivery System</span>
            </h2>

            <p>
                This website is designed as a complete
                digital platform for a local general store.
                It brings product browsing, shopping,
                customer accounts, order management and
                delivery management together in one system.
            </p>


            <div class="project-points">

                <div>
                    ✓ Customer Shopping
                </div>

                <div>
                    ✓ Cart & Checkout
                </div>

                <div>
                    ✓ Saved Delivery Address
                </div>

                <div>
                    ✓ Order Tracking
                </div>

                <div>
                    ✓ Admin Management
                </div>

                <div>
                    ✓ Delivery Management
                </div>

            </div>

        </div>


        <div class="project-box">

            <div class="project-box-icon">
                💻
            </div>

            <h3>
                Digital Store Platform
            </h3>

            <p>
                Built to connect customers,
                store management and delivery
                operations.
            </p>

        </div>

    </section>



    <!-- =========================
         DEVELOPER
    ========================== -->

    <section class="section developer-section">

        <div class="section-heading center">

            <span>
                DEVELOPER
            </span>

            <h2>
                Meet the Developer
            </h2>

        </div>


        <div class="developer-card">


            <div class="developer-avatar">
                SK
            </div>


            <div class="developer-info">

                <span class="developer-label">
                    DESIGNED & DEVELOPED BY
                </span>

                <h2>
                    Sintu Kumar
                </h2>

                <h3>
                    BCA Graduate & Web Developer
                </h3>

                <p>
                    Passionate about creating useful,
                    simple and user-friendly web
                    applications. This project was
                    designed and developed as a complete
                    local store and home-delivery
                    platform.
                </p>


                <div class="skills">

                    <span>HTML</span>
                    <span>CSS</span>
                    <span>JavaScript</span>
                    <span>Node.js</span>
                    <span>Express.js</span>
                    <span>MongoDB</span>
                    <span>Python</span>
                    <span>Java</span>

                </div>


                <div class="developer-links">

                    <a
                        href="https://sintuprajapati.vercel.app/"
                        target="_blank"
                    >
                        🌐 Portfolio
                    </a>

                    <a
                        href="https://github.com/sintukrbca"
                        target="_blank"
                    >
                        💻 GitHub
                    </a>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================
         PRIVACY
    ========================== -->

    <section class="section security-section">

        <div class="security-card">

            <div class="security-icon">
                🔐
            </div>

            <div>

                <span>
                    PRIVACY & SECURITY
                </span>

                <h2>
                    Your Information Matters
                </h2>

                <p>
                    Customer account, order and delivery
                    information is handled through
                    protected access. We only display
                    information that is necessary for
                    providing the store and delivery
                    service.
                </p>

            </div>

        </div>

    </section>



    <!-- =========================
         CTA
    ========================== -->

    <section class="cta">

        <div>

            <span>
                READY TO SHOP?
            </span>

            <h2>
                Find what you need today.
            </h2>

            <p>
                Browse our products and place your
                order easily.
            </p>

        </div>


        <a
            href="/"
        >
            Shop Now →
        </a>

    </section>



    <!-- =========================
         FOOTER
    ========================== -->

   <footer>

        <div class="footer-brand">

            🛒

            <strong>
                MS Cyber Cafe & General Store
            </strong>

        </div>


        <p>
            Your trusted local store for daily needs.
        </p>


        <small> 
            &copy; 2024 MS Cyber Cafe & General Store. All rights reserved.
        </small>

    </footer>



</body>

</html>