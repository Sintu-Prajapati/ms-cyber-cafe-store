<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Customer Login | MS Cyber Cafe</title>

    <link
        rel="stylesheet"
        href="/css/customer-auth.css"
    >
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/customer-home.css">


</head>


<body>

     <!-- =========================
         NAVBAR
    ========================== -->

    <header class="customer-navbar">

        <div class="brand">

            <div class="brand-icon"
            onclick="window.location.href='/shop'"
            >
                🛒
            </div>

            <div>

                <h1>
                    MS Cyber Cafe
                </h1>

                <span>
                    & General Store
                </span>

            </div>

        </div>


        <div class="nav-actions">

            <button
                class="search-btn"
                onclick="focusSearch()"
                title="Search"
            >
                🔍
            </button>
         
                <a
                    href="/customer/login"
                    class="action-link login-btn"
                    title="Login"
                >
                    🔐 Login
                </a>

                <a
                    href="/customer/signup"
                    class="action-link signup-btn"
                    title="Sign Up"
                >
                    📝 Sign Up
                </a>

                <a
                    href="/admin/login"
                    class="action-link admin-login-btn"
                    title="Admin Login"
                >
                    🛡️ Admin Login
                </a>

                <a
                    href="/delivery/login"
                    class="action-link delivery-login-btn"
                    title="Delivery Login"
                >
                    🚚 Delivery Login
                </a>


        </div>

    </header>


<div class="auth-container">


    <div class="auth-card">


        <div class="auth-logo">
            👋
        </div>


        <h1>
            Welcome Back
        </h1>


        <p class="auth-subtitle">
            Login to continue shopping
        </p>


        <form
            action="/customer/login"
            method="POST"
        >


            <!-- EMAIL / MOBILE -->

            <div class="form-group">

                <label>
                    Email / Mobile Number
                </label>

                <input
                    type="text"
                    name="login"
                    placeholder="Enter email or mobile number"
                    autocomplete="username"
                    required
                >

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label>
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="Enter password"
                    autocomplete="current-password"
                    required
                >

            </div>


            <button
                type="submit"
                class="auth-btn"
            >
                Login
            </button>


        </form>


        <div class="auth-bottom">

            Don't have an account?

            <a href="/customer/signup">
                Create Account
            </a>

        </div>


    </div>


</div>


</body>

</html>