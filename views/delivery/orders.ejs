<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        My Orders | Delivery
    </title>

    <link
        rel="stylesheet"
        href="/css/delivery-orders.css"
    >

</head>


<body>


    <!-- HEADER -->

    <header class="topbar">

        <div class="brand">

            <div class="brand-icon">
                🚚
            </div>

            <div>

                <strong>
                    MS Cyber Cafe
                </strong>

                <span>
                    Delivery Panel
                </span>

            </div>

        </div>


        <div class="nav-actions">

            <a
                href="/delivery/dashboard"
                class="nav-link"
            >
                Dashboard
            </a>

            <a
                href="/delivery/logout"
                class="logout"
            >
                Logout
            </a>

        </div>

    </header>



    <main class="page">

        <% if (success === "delivered") { %>

    <div class="success-message">

        <div class="success-icon">
            ✓
        </div>

        <div>

            <strong>
                Order Delivered Successfully!
            </strong>

            <span>
                Customer ko order successfully deliver kar diya gaya.
            </span>

        </div>

    </div>

<% } %>


        <!-- HEADING -->

        <div class="page-heading">

            <div>

                <span>
                    DELIVERY MANAGEMENT
                </span>

                <h1>
                    My Orders
                </h1>

                <p>
                    Orders assigned to you
                </p>

            </div>


            <div class="order-count">

                <strong>
                    <%= orders.length %>
                </strong>

                <span>
                    Orders
                </span>

            </div>

        </div>



        <% if (orders.length === 0) { %>


            <div class="empty">

                <div>
                    📦
                </div>

                <h2>
                    No Orders Assigned
                </h2>

                <p>
                    Admin se order assign hone par
                    yahan dikhega.
                </p>

                <a
                    href="/delivery/dashboard"
                >
                    ← Dashboard
                </a>

            </div>


        <% } else { %>


            <div class="orders-list">


                <% orders.forEach(order => { %>


                    <article class="order-card">


                        <!-- ORDER HEADER -->

                        <div class="order-header">

                            <div>

                                <span>
                                    ORDER ID
                                </span>

                                <h2>
                                    #<%= order.orderId %>
                                </h2>

                                <small>

                                    <%= new Date(
                                        order.createdAt
                                    ).toLocaleString(
                                        "en-IN"
                                    ) %>

                                </small>

                            </div>


                            <span class="status">

                                <%= order.orderStatus %>

                            </span>

                        </div>



                        <!-- CUSTOMER -->

                        <div class="customer">

                            <div class="customer-avatar">

                                <%= (
                                    order.customer
                                        ? order.customer.name
                                        : order.deliveryAddress.name
                                )
                                    .charAt(0)
                                    .toUpperCase()
                                %>

                            </div>


                            <div class="customer-info">

                                <strong>

                                    <%= order.customer
                                        ? order.customer.name
                                        : order.deliveryAddress.name
                                    %>

                                </strong>

                                <span>

                                    📞
                                    <%= order.deliveryAddress.number %>

                                </span>

                            </div>


                            <a
                                href="tel:<%= order.deliveryAddress.number %>"
                                class="call-btn"
                            >
                                📞 Call
                            </a>

                        </div>



                        <!-- ADDRESS -->

                        <div class="address">

                            <span>
                                📍 DELIVERY ADDRESS
                            </span>

                            <p>

                                <%= order.deliveryAddress.house %>,

                                <%= order.deliveryAddress.village %>,

                                <%= order.deliveryAddress.district %>,

                                <%= order.deliveryAddress.state %>
                                -

                                <%= order.deliveryAddress.pincode %>

                            </p>

                        </div>



                        <!-- PAYMENT -->

                        <div class="payment-row">


                            <div>

                                <span>
                                    PAYMENT
                                </span>

                                <strong>
                                    <%= order.paymentMethod %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    PAYMENT STATUS
                                </span>

                                <strong
                                    class="<%= order.paymentStatus === 'Paid'
                                        ? 'paid'
                                        : 'pending' %>"
                                >
                                    <%= order.paymentStatus %>
                                </strong>

                            </div>


                            <div>

                                <span>
                                    TOTAL
                                </span>

                                <strong class="total">

                                    ₹<%= Number(
                                        order.grandTotal
                                    ).toFixed(2) %>

                                </strong>

                            </div>


                        </div>



                        <!-- COD -->

                        <% if (
                            order.paymentMethod === "COD" &&
                            order.paymentStatus !== "Paid"
                        ) { %>

                            <div class="cod-warning">

                                💰

                                <div>

                                    <strong>
                                        Collect from Customer
                                    </strong>

                                    <span>
                                        ₹<%= Number(
                                            order.grandTotal
                                        ).toFixed(2) %>
                                    </span>

                                </div>

                            </div>

                        <% } %>



                        <!-- VIEW -->

                        <a
                            href="/delivery/orders/<%= order._id %>"
                            class="details-btn"
                        >
                            View Full Order
                            <span>→</span>
                        </a>


                    </article>


                <% }) %>


            </div>


        <% } %>


    </main>

    <footer>

       
        <div class="footer-brand">

            🛒

            <strong>
                MS Cyber Cafe & General Store
            </strong>

        </div>


        <p>
            Your trusted local store for daily needs.
        </p>


        <small>

            © <%= new Date().getFullYear() %>
            MS Cyber Cafe & General Store   
            <a style="text-decoration: none; color: white; font-weight: 600;" href="/customer/about">About Us</a>

        </small>




    </footer>


</body>

</html>