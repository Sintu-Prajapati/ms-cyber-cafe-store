<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Bill <%= transaction.billNumber %>
    </title>

    <link
        rel="stylesheet"
        href="/css/customer.css"
    >
    <link rel="stylesheet" href="style.css">

</head>


<body>

<main>

    <div class="bill-print">


        <div class="bill-header">

            <h1>
                MS Cyber Cafe & General Store
            </h1>

            <p>
                Customer Bill
            </p>

        </div>


        <hr>


        <div class="bill-info">

            <p>
                <strong>Bill No:</strong>
                <%= transaction.billNumber %>
            </p>

            <p>
                <strong>Date:</strong>
                <%= new Date(
                    transaction.date
                ).toLocaleString("en-IN") %>
            </p>

            <p>
                <strong>Customer:</strong>
                <%= customer.name %>
            </p>

            <p>
                <strong>Village:</strong>
                <%= customer.village || "-" %>
            </p>

        </div>


        <table>

            <thead>

                <tr>

                    <th>Product</th>

                    <th>Qty</th>

                    <th>Rate</th>

                    <th>Total</th>

                </tr>

            </thead>


            <tbody>

                <% transaction.items.forEach(item => { %>

                    <tr>

                        <td>
                            <%= item.name %>
                        </td>

                        <td>
                            <%= item.quantity %>
                            <%= item.unit %>
                        </td>

                        <td>
                            ₹<%= item.price.toFixed(2) %>
                        </td>

                        <td>
                            ₹<%= item.total.toFixed(2) %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>


        <div class="bill-total">

            <p>
                Product Total:
                ₹<%= transaction.productTotal.toFixed(2) %>
            </p>

            <p>
                Printing:
                ₹<%= transaction.printingCharge.toFixed(2) %>
            </p>

            <h3>
                Grand Total:
                ₹<%= transaction.grandTotal.toFixed(2) %>
            </h3>

            <p>
                Paid:
                ₹<%= transaction.paidAmount.toFixed(2) %>
            </p>

            <p class="credit">
                Udhar:
                ₹<%= transaction.creditAmount.toFixed(2) %>
            </p>

        </div>


        <button
            class="print-btn no-print"
            onclick="window.print()"
        >
            🖨️ Print Bill
        </button>


    </div>

</main>

</body>

</html>