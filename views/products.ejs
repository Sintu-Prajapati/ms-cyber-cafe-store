<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Products - MS Cyber Cafe & General Store</title>

    <link rel="stylesheet" href="/css/style.css">
    <style>
        .products-page {
            min-height: 100vh;
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
        }

        /* Product Form */

        .product-form {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(15, 23, 42, 0.08);
            animation: slideUp 0.7s ease;
        }

        .product-form h2 {
            margin-bottom: 25px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
            background: #fff;
            transition: 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
            transform: translateY(-1px);
        }

        /* Add Button */

        .add-product-btn {
            margin-top: 25px;
            padding: 13px 24px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s ease;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
        }

        .add-product-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(79, 70, 229, 0.35);
        }

        .add-product-btn:active {
            transform: scale(0.97);
        }

        /* Product List */

        .product-list-box {
            margin-top: 30px;
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(15, 23, 42, 0.07);
            animation: slideUp 0.9s ease;
        }

        .product-list-box h2 {
            margin-bottom: 20px;
        }

        /* Table */

        .product-table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
        }

        .product-table thead {
            background: #111827;
            color: white;
        }

        .product-table th,
        .product-table td {
            padding: 14px 16px;
            text-align: left;
        }

        .product-table th {
            font-size: 14px;
            font-weight: 600;
        }

        .product-table tbody tr {
            border-bottom: 1px solid #eee;
            transition: 0.25s ease;
        }

        .product-table tbody tr:hover {
            background: #f5f7ff;
            transform: scale(1.005);
        }

        /* Product Name */

        .product-name {
            font-weight: 600;
            color: #1f2937;
        }

        /* Price */

        .product-price {
            font-weight: 700;
            color: #059669;
        }

        /* Unit Badge */

        .unit-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 12px;
            font-weight: 600;
        }

        /* Stock */

        .stock {
            font-weight: 600;
        }

        .stock-low {
            color: #dc2626;
        }

        .stock-good {
            color: #059669;
        }

        /* Animation */

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Floating animation */

        .product-form,
        .product-list-box {
            transition: transform 0.3s ease;
        }

        .product-form:hover,
        .product-list-box:hover {
            transform: translateY(-2px);
        }

        /* Mobile */

        @media (max-width: 700px) {

            .form-grid {
                grid-template-columns: 1fr;
            }

            .product-list-box {
                overflow-x: auto;
            }

            .product-table {
                min-width: 700px;
            }
        }
    </style>
</head>

<body class="products-page">

    <header>
        <h1>MS Cyber Cafe & General Store</h1>
        <p>Product Management</p>
    </header>

    <main>

        <div class="product-form">

            <a class="back_btn" href="/">Back to Dashboard</a>
            <h2>➕ Add New Product</h2>

            <form action="/products/add" method="POST">

                <div class="form-grid">

                    <div class="form-group">
                        <label>Product Name</label>
                        <input type="text" name="name" placeholder="e.g. Chini" required>
                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        <select name="category" id="category" required>
                            <option value="">Select Category</option>
                            <option value="grocery">Grocery</option>
                            <option value="snacks">Snacks</option>
                            <option value="drinks">Drinks</option>
                            <option value="personal-care">Personal Care</option>
                            <option value="stationery">Stationery</option>
                            <option value="electronics">Electronics</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Unit</label>

                        <select name="unit" required>
                            <option value="">Select Unit</option>
                            <option value="piece">Piece</option>
                            <option value="kg">Kg</option>
                            <option value="gram">Gram</option>
                            <option value="litre">Litre</option>
                            <option value="ml">ML</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Print Price / MRP</label>

                        <input type="number" name="printPrice" placeholder="₹ Print Price / MRP" min="0" step="0.01"
                            required>


                        <label>Selling Price</label>

                        <input type="number" name="sellingPrice" placeholder="₹ Selling Price" min="0" step="0.01"
                            required>
                    </div>

                    <div class="form-group">
                        <label>Stock</label>
                        <input type="number" name="stock" step="0.001" min="0" placeholder="e.g. 50" required>
                    </div>

                </div>

                <button type="submit" class="add-product-btn">
                    Add Product
                </button>

            </form>


            <br>

            <div class="product-list-box">

                <h2>📦 Product List</h2>

                <table class="product-table">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Update Image</th>
                            <th>Update Stock</th>
                            <th>Update Price</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% products.forEach(product=> { %>

                            <tr>

                                <td class="product-name">
                                    <%= product.name %>
                                </td>

                                <td>
                                    <%= product.category %>
                                </td>

                                <td>
                                    <span class="unit-badge">
                                        <%= product.unit %>
                                    </span>
                                </td>

                                <td class="product-price">
                                    ₹<%= (product.sellingPrice || 0).toFixed(2) %>
                                </td>

                                <td class="stock">
                                    <%= product.stock %>
                                </td>
                                <td>
                                      <button
        type="button"
        class="update-image-btn"
        onclick="updateImage('<%= product._id %>')"
    >
        🖼️ Update
    </button>
                                </td>

                                <td> <button type="button" onclick="updateStock('<%= product._id %>')"
                                        class="update-stock-btn">
                                        📦 Update
                                    </button></td>
                                <td><button type="button" class="update-price-btn"
                                        onclick="updatePrice('<%= product._id %>')">
                                        💰 Update
                                    </button></td>


                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>
    </main>


    <script>
        function updateStock(id) {

            const stock = prompt("Naya stock quantity enter kare:");

            if (stock === null) return;

            if (stock === "" || Number(stock) < 0) {
                alert("Valid stock quantity enter kare.");
                return;
            }

            fetch(`/products/${id}/stock`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    stock: Number(stock)
                })
            })
                .then(response => response.json())
                .then(data => {

                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || "Stock update nahi hua.");
                    }

                })
                .catch(error => {
                    console.error(error);
                    alert("Something went wrong.");
                });
        }
        function updatePrice(id) {

            const mrp = prompt("Naya Print Price / MRP enter kare:");

            if (mrp === null) return;

            if (mrp === "" || Number(mrp) < 0 || isNaN(Number(mrp))) {
                alert("Valid MRP enter kare.");
                return;
            }


            const sellingPrice = prompt(
                "Naya Selling Price enter kare:"
            );

            if (sellingPrice === null) return;

            if (
                sellingPrice === "" ||
                Number(sellingPrice) < 0 ||
                isNaN(Number(sellingPrice))
            ) {
                alert("Valid Selling Price enter kare.");
                return;
            }


            if (Number(sellingPrice) > Number(mrp)) {

                alert(
                    "Selling Price MRP se zyada nahi ho sakta."
                );

                return;
            }


            fetch(`/products/${id}/price`, {

                method: "PUT",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({

                    printPrice: Number(mrp),

                    sellingPrice: Number(sellingPrice)

                })

            })
                .then(response => response.json())

                .then(data => {

                    if (data.success) {

                        location.reload();

                    } else {

                        alert(
                            data.message ||
                            "Price update nahi hua."
                        );

                    }

                })
                .catch(error => {

                    console.error(error);

                    alert("Something went wrong.");

                });

        }

        function updateImage(id) {

    const input = document.createElement("input");

    input.type = "file";
    input.accept = "image/*";

    input.onchange = async function () {

        if (!input.files || input.files.length === 0) {
            return;
        }

        const file = input.files[0];

        const formData = new FormData();

        formData.append("image", file);


        try {

            const response = await fetch(
                `/products/${id}/image`,
                {
                    method: "PUT",
                    body: formData
                }
            );


            const data = await response.json();


            if (data.success) {

                alert("Product image updated successfully.");

                location.reload();

            } else {

                alert(
                    data.message ||
                    "Image update nahi hua."
                );

            }

        } catch (error) {

            console.error(error);

            alert("Image update failed.");

        }

    };


    input.click();

}
    </script>
</body>

</html>